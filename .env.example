# ---------------------------------------------------------------------------
# StudyCoach configuration. Copy to `.env.local` and edit as needed.
# The app runs fully offline with the defaults below (no API key required).
# ---------------------------------------------------------------------------

# LLM provider used for the *narrow* AI features (question generation,
# answer feedback, insight summaries). One of: mock | ollama | openai
#   - mock   : deterministic, offline, no dependencies. Great for the demo.
#   - ollama : local open-source models via http://localhost:11434
#   - openai : any OpenAI-compatible endpoint (OpenAI, LM Studio, llama.cpp...)
LLM_PROVIDER=mock

# --- ollama settings (only used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- openai-compatible settings (only used when LLM_PROVIDER=openai) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Path to the local SQLite database file.
DATABASE_PATH=./db/studycoach.sqlite
