# ---------------------------------------------------------------------------
# StudyCoach configuration. Copy to `.env.local` and edit as needed.
# The app runs fully offline with the defaults below (no API key required).
# ---------------------------------------------------------------------------

# LLM provider used for the *narrow* AI features (question generation,
# answer feedback, insight summaries). One of: mock | ollama | openai
#   - mock   : deterministic, offline, no dependencies. Great for the demo.
#   - ollama : local open-source models via http://localhost:11434
#   - openai : any OpenAI-compatible endpoint (OpenAI, LM Studio, llama.cpp...)
LLM_PROVIDER=mock

# --- ollama settings (only used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- openai-compatible settings (only used when LLM_PROVIDER=openai) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Path to the local SQLite database file.
DATABASE_PATH=./db/studycoach.sqlite

# Hosted Turso database (production). When TURSO_DATABASE_URL is set it is used
# instead of DATABASE_PATH. Create with: turso db create calibrate
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Pilot / production settings
# ---------------------------------------------------------------------------

# Student sign-in. Defaults to REQUIRED in production builds and OFF in
# `next dev` and tests (single local user). Set AUTH_REQUIRED=true locally to
# try the sign-in flow, or false for a deliberate single-user production demo.
# AUTH_REQUIRED=true

# Secret used to sign session cookies. REQUIRED in production, at least 32
# random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Set to false to disable the shared "explore the demo" account on /signin.
# DEMO_ACCOUNT_ENABLED=true

# Maximum AI question generations per student in any rolling 24 hours.
# GENERATIONS_PER_DAY=15

# Production refuses to start on a local SQLite file (hosts wipe local disks).
# Only set this if the app really runs on a persistent disk you control.
# ALLOW_LOCAL_DB=true

# Team emails to leave out of `npm run metrics` (comma separated).
# METRICS_EXCLUDE_EMAILS=you@school.edu,teammate@school.edu
